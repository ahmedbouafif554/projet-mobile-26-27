{
  "name": "superfaster-backend",
  "version": "1.0.0",
  "description": "SuperFaster REST API — livraison de repas, courses et colis",
  "main": "src/app.js",
  "scripts": {
    "start": "node --experimental-sqlite src/app.js",
    "dev": "nodemon --exec \"node --experimental-sqlite\" src/app.js",
    "test": "node --experimental-sqlite ./node_modules/jest/bin/jest.js",
    "test:module3": "node --experimental-sqlite ./node_modules/jest/bin/jest.js tests/oussema-panier-commande.test.js tests/e2e-frontend-backend-link.test.js",
    "seed:module3": "node --experimental-sqlite src/oussema_panier_commande/seed/seed-demo-orders.js",
    "seed:catalogue": "node src/restaurant_catalogue/seed/seed-demo-catalogue.js"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/tests/setup.js"
    ]
  },
  "keywords": [
    "superfaster",
    "delivery",
    "express",
    "api"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-validator": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "supertest": "^7.0.0"
  }
}
