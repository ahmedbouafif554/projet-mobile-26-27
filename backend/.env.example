# ── Server ──────────────────────────────────────────────────────────────────
PORT=3001
# development | production   (production : contrôles stricts au démarrage)
NODE_ENV=development
# URL publique de l'API, utilisée dans les liens des e-mails
PUBLIC_URL=http://localhost:3001
# Derrière un proxy / hébergeur (Render, Railway, Nginx…) : true
TRUST_PROXY=false
# Origines web autorisées (back office Flutter web), séparées par des virgules.
# Vide = toutes (développement uniquement).
CORS_ORIGINS=

# ── JWT ─────────────────────────────────────────────────────────────────────
# Production : au moins 32 caractères aléatoires, par exemple :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_super_secret_key_here
JWT_EXPIRES_IN=7d

# ── SQLite : un fichier local, sans serveur ni mot de passe ────────────────
DB_NAME=superfaster
# Comptes de démonstration dans une base vide (true par défaut hors production)
# SEED_DEMO=false

# ── Premier administrateur (créé au démarrage s'il n'existe aucun admin) ───
ADMIN_EMAIL=
ADMIN_PASSWORD=
# ADMIN_FIRST_NAME=Admin
# ADMIN_LAST_NAME=SuperFaster
# ADMIN_PHONE=+33 6 00 00 00 00

# ── Connexion Google ────────────────────────────────────────────────────────
# Identifiants client OAuth acceptés (Web, Android, iOS), séparés par des virgules.
# Google Cloud Console › API et services › Identifiants.
GOOGLE_CLIENT_IDS=

# ── E-mails (mot de passe oublié) ──────────────────────────────────────────
# Vide : le lien de réinitialisation est écrit dans le journal du serveur.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=SuperFaster <no-reply@superfaster.fr>

# ── Démonstration ───────────────────────────────────────────────────────────
# Code SMS de démo « 1234 » (toujours désactivé en production)
# ALLOW_DEMO_OTP=true
